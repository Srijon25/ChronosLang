# --- Code Section ---
function add(a, b):
    return a + b

function multiply(a, b):
    return a * b

function compute(a, b):
    sum = add(a, b)
    product = multiply(a, b)
    return sum + product

print("Compute(5, 6) =")
print(compute(5, 6))   # Expected output: 41


# --- Tests Section ---
test "addition works":
    assert add(5, 6) == 11

test "multiplication works":
    assert multiply(5, 6) == 30

test "composed compute works":
    assert compute(5, 6) == 41
